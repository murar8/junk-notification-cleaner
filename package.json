{
  "name": "junk-notification-cleaner",
  "version": "0.0.0",
  "description": "GNOME extension to delete notifications when an application window is focused or closed.",
  "type": "module",
  "private": true,
  "author": "Lorenzo Murarotto",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "compile-schemas": "glib-compile-schemas schemas",
    "prepackage": "npm run build",
    "package": "cd dist && cp ../metadata.json . && gnome-extensions pack --force --extra-source=prefs.js --schema=../schemas/org.gnome.shell.extensions.junk-notification-cleaner.gschema.xml",
    "preinstall-extension": "npm run package && npm run compile-schemas",
    "install-extension": "gnome-extensions install --force dist/junk-notification-cleaner@murar8.github.com.shell-extension.zip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.ts": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/gjs": "^5.5.0",
    "@girs/gnome-shell": "^50.0.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
